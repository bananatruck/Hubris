{
    "name": "@hubris/core",
    "version": "0.1.0",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "lint": "eslint ."
    },
    "dependencies": {
        "@hubris/types": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.3.0",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "typescript-eslint": "^8.73.0",
        "vitest": "5.1.0"
    }
}
